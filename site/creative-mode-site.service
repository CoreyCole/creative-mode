[Unit]
Description=Creative Mode Marketing Site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/creative-mode/site
ExecStart=/tmp/creative-mode-site
EnvironmentFile=/home/ubuntu/.config/creative-mode/site.env
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
