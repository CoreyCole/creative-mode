package layouts

import (
	"path/filepath"

	"github.com/coreycole/creative-mode/site/internal/ui/tooltip"
	"github.com/coreycole/creative-mode/site/internal/ui/utils"
)

templ Root(args RootArgs) {
	{{
		// Find the hashed CSS file
		cssFile := "/css/out.css" // fallback
		if files, err := filepath.Glob("static/css/out.*.css"); err == nil && len(files) > 0 {
			fileName := filepath.Base(files[0])
			cssFile = "/css/" + fileName
		}
	}}
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>{ args.Title }</title>
			<meta charset="UTF-8"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon.png"/>
			<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Meet the Mayor — your AI game dev assistant. Create multiplayer worlds from Discord."/>
			<!-- Tailwind CSS -->
			<link rel="stylesheet" href={ cssFile }/>
			<!-- Theme initialization -->
			<script>
				function initTheme() {
					const theme =
						localStorage.getItem("theme") ||
						(window.matchMedia("(prefers-color-scheme: dark)").matches
							? "dark"
							: "light");
					document.documentElement.classList.toggle("dark", theme === "dark");
					return theme;
				}
				initTheme();
			</script>
			<!-- Datastar -->
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.0-RC.7/bundles/datastar.js"></script>
		</head>
		<body class="min-h-screen bg-background font-sans antialiased" data-signals="{theme: initTheme()}">
			<div class="relative flex min-h-screen flex-col bg-background">
				<!-- Header -->
				<header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
					<div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
						<!-- Left: Logo -->
						<a class="flex items-center no-underline" href="/">
							<span class="font-semibold text-foreground text-lg">Creative Mode</span>
						</a>
						<!-- Right: Nav links -->
						<nav class="flex items-center gap-4">
							<a href="/status" class="hidden sm:inline text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
								Status
							</a>
							<a
								href="https://github.com/coreycole/creative-mode"
								target="_blank"
								rel="noreferrer"
								class="hidden sm:inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-9 w-9"
							>
								<svg viewBox="0 0 438.549 438.549" class="h-4 w-4">
									<path
										fill="currentColor"
										d="M409.132 114.573c-19.608-33.596-46.205-60.194-79.798-79.8-33.598-19.607-70.277-29.408-110.063-29.408-39.781 0-76.472 9.804-110.063 29.408-33.596 19.605-60.192 46.204-79.8 79.8C9.803 148.168 0 184.854 0 224.63c0 47.78 13.94 90.745 41.827 128.906 27.884 38.164 63.906 64.572 108.063 79.227 5.14.954 8.945.283 11.419-1.996 2.475-2.282 3.711-5.14 3.711-8.562 0-.571-.049-5.708-.144-15.417a2549.81 2549.81 0 01-.144-25.406l-6.567 1.136c-4.187.767-9.469 1.092-15.846 1-6.374-.089-12.991-.757-19.842-1.999-6.854-1.231-13.229-4.086-19.13-8.559-5.898-4.473-10.085-10.328-12.56-17.556l-2.855-6.57c-1.903-4.374-4.899-9.233-8.992-14.559-4.093-5.331-8.232-8.945-12.419-10.848l-1.999-1.431c-1.332-.951-2.568-2.098-3.711-3.429-1.142-1.331-1.997-2.663-2.568-3.997-.572-1.335-.098-2.43 1.427-3.289 1.525-.859 4.281-1.276 8.28-1.276l5.708.853c3.807.763 8.516 3.042 14.133 6.851 5.614 3.806 10.229 8.754 13.846 14.842 4.38 7.806 9.657 13.754 15.846 17.847 6.184 4.093 12.419 6.136 18.699 6.136 6.28 0 11.704-.476 16.274-1.423 4.565-.952 8.848-2.383 12.847-4.285 1.713-12.758 6.377-22.559 13.988-29.41-10.848-1.14-20.601-2.857-29.264-5.14-8.658-2.286-17.605-5.996-26.835-11.14-9.235-5.137-16.896-11.516-22.985-19.126-6.09-7.614-11.088-17.61-14.987-29.979-3.901-12.374-5.852-26.648-5.852-42.826 0-23.035 7.52-42.637 22.557-58.817-7.044-17.318-6.379-36.732 1.997-58.24 5.52-1.715 13.706-.428 24.554 3.853 10.85 4.283 18.794 7.952 23.84 10.994 5.046 3.041 9.089 5.618 12.135 7.708 17.705-4.947 35.976-7.421 54.818-7.421s37.117 2.474 54.823 7.421l10.849-6.849c7.419-4.57 16.18-8.758 26.262-12.565 10.088-3.805 17.802-4.853 23.134-3.138 8.562 21.509 9.325 40.922 2.279 58.24 15.036 16.18 22.559 35.787 22.559 58.817 0 16.178-1.958 30.497-5.853 42.966-3.9 12.471-8.941 22.457-15.125 29.979-6.191 7.521-13.901 13.85-23.131 18.986-9.232 5.14-18.182 8.85-26.84 11.136-8.662 2.286-18.415 4.004-29.263 5.146 9.894 8.562 14.842 22.077 14.842 40.539v60.237c0 3.422 1.19 6.279 3.572 8.562 2.379 2.279 6.136 2.95 11.276 1.995 44.163-14.653 80.185-41.062 108.068-79.226 27.88-38.161 41.825-81.126 41.825-128.906-.01-39.771-9.818-76.454-29.414-110.049z"
									></path>
								</svg>
								<span class="sr-only">GitHub</span>
							</a>
							<!-- Theme toggle -->
							<button
								class="relative inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-9 w-9"
								data-on:click="$theme = $theme === 'dark' ? 'light' : 'dark'; document.documentElement.classList.toggle('dark', $theme === 'dark'); localStorage.setItem('theme', $theme);"
							>
								<!-- Sun icon (visible in light mode, hidden in dark mode) -->
								<svg
									class="h-4 w-4 transition-all"
									data-class="{'rotate-0 scale-100': $theme === 'light', '-rotate-90 scale-0': $theme === 'dark'}"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<circle cx="12" cy="12" r="5"></circle>
									<path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
								</svg>
								<!-- Moon icon (hidden in light mode, visible in dark mode) -->
								<svg
									class="absolute h-4 w-4 transition-all"
									data-class="{'rotate-90 scale-0': $theme === 'light', 'rotate-0 scale-100': $theme === 'dark'}"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
								</svg>
								<span class="sr-only">Toggle theme</span>
							</button>
							if !args.HideMayorCTA {
								<a
									href="/mayor"
									class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4"
								>
									Meet the Mayor
								</a>
							}
						</nav>
					</div>
				</header>
				<!-- Main content -->
				<main class="flex-1">
					{ children... }
				</main>
				<!-- Footer -->
				if !args.HideFooter {
					<footer class="border-t border-border/40 py-6">
						<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
							<!-- Mobile-only nav links (hidden in header on small screens) -->
							<div class="flex sm:hidden items-center justify-center gap-4 mb-3">
								<a href="/status" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
									Status
								</a>
								<a
									href="https://github.com/coreycole/creative-mode"
									target="_blank"
									rel="noreferrer"
									class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
								>
									GitHub
								</a>
							</div>
							<p class="text-center text-sm text-muted-foreground">
								@tooltip.TooltipTrigger(tooltip.TooltipTriggerArgs{TooltipID: "commit-hash", Class: "inline"}) {
									Built
								}
								@tooltip.TooltipContent(tooltip.TooltipContentArgs{ID: "commit-hash", UseAnchor: true, Side: utils.AnchorSideTop}) {
									{ args.Commit }
								}
								&nbsp;with
								<a href="https://bevyengine.org" target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-foreground">Bevy</a>,
								<a href="https://go.dev" target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-foreground">Go</a>
								<a href="https://data-star.dev" target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-foreground">Datastar</a>, and <a href="https://datastar-ui.com/" target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-foreground">DatastarUI</a>
								Open source on
								<a href="https://github.com/coreycole/creative-mode" target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-foreground">GitHub</a>.
							</p>
						</div>
					</footer>
				}
			</div>
		</body>
	</html>
}
