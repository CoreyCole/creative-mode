package layout

import (
	"creative-mode/harness/views/dsutil"
	"path/filepath"
)

// Head renders the shared <head> block for all pages.
templ Head(title string) {
	{{
		cssFile := "/static/css/out.css" // fallback for dev watch mode
		if files, err := filepath.Glob("static/css/out.*.css"); err == nil && len(files) > 0 {
			cssFile = "/static/css/" + filepath.Base(files[0])
		}
	}}
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } — Creative Mode</title>
		<script type="module" defer src="/static/datastar.js"></script>
		<link rel="stylesheet" href={ cssFile }/>
	</head>
}

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		@Head(title)
		<body>
			if isDevMode() {
				<div id="dev-sse" data-init={ dsutil.GetSSENoCancel("/dev/sse") }></div>
			}
			<div id="page-content">
				{ children... }
			</div>
		</body>
	</html>
}
