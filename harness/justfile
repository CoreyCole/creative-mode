default:
    @just --list

dev:
    go run .

build:
    go build -o harness .

test:
    go test ./...

sqlc:
    sqlc generate

generate:
    sqlc generate
    templ generate
    just build-tailwind

fmt:
    golangci-lint fmt ./...

lint:
    golangci-lint run ./...

# --- Tailwind CSS ---

# Build Tailwind CSS with content-hash filename for cache busting
build-tailwind:
    #!/usr/bin/env bash
    echo "Building Tailwind CSS..."
    tailwindcss -i static/css/index.css -o static/css/out.css \
        --content "./views/**/*"
    if [ -f static/css/out.css ]; then
        HASH=$(shasum -a 256 static/css/out.css | cut -d' ' -f1 | head -c8)
        rm -f static/css/out.*.css
        cp static/css/out.css "static/css/out.$HASH.css"
        echo "Created static/css/out.$HASH.css"
    fi

# Watch mode for Tailwind (dev, no hashing)
tailwind-watch:
    tailwindcss -i static/css/index.css -o static/css/out.css \
        --content "./views/**/*" --watch

# --- Development (Docker + Host Watcher) ---

# Start everything: Docker container + host file watcher + Tailwind
live:
    #!/usr/bin/env bash
    trap 'kill 0' EXIT
    just -f {{justfile()}} up &
    sleep 5  # wait for container to be ready
    just -f {{justfile()}} tailwind-watch &
    just -f {{justfile()}} watch &
    wait

# Start Docker container
up:
    docker compose up --build

# Stop Docker container
down:
    docker compose down

# Host-side file watcher (native FSEvents, no polling)
# Note: .rs files are NOT watched here — cargo watch + trunk serve handle
# Rust rebuilds automatically inside Docker.
watch:
    #!/usr/bin/env bash
    echo "Watching for file changes..."
    fswatch -0 -r --latency=0.3 \
        --include='\.templ$' \
        --include='\.go$' \
        --include='\.css$' \
        --exclude='_templ\.go$' \
        --exclude='.*' \
        . | while IFS= read -r -d '' file; do
        case "$file" in
            *.templ)
                echo "  .templ changed: $file → generate + rebuild"
                templ generate 2>&1 | tail -1
                curl -s -X POST http://localhost:8080/dev/rebuild > /dev/null &
                ;;
            *.go)
                echo "  .go changed: $file → rebuild"
                curl -s -X POST http://localhost:8080/dev/rebuild > /dev/null &
                ;;
            *.css)
                echo "  .css changed: $file → reload static"
                curl -s -X POST http://localhost:8080/dev/reload-static > /dev/null &
                ;;
        esac
    done

# Open a shell in the running container
shell:
    docker compose exec harness bash

# Show container logs
logs:
    docker compose logs -f harness

# --- VPS (Nix + systemd) ---

# Build harness binary for VPS
vps-build:
    templ generate
    just build-tailwind
    CGO_ENABLED=1 go build -o harness .

# Deploy: pull, build, restart service
vps-deploy:
    git pull
    just vps-build
    sudo systemctl restart creative-mode

# Service logs
vps-logs:
    journalctl -u creative-mode -f

# Service status
vps-status:
    systemctl status creative-mode

# Redeploy (pull latest + rebuild + restart)
redeploy:
    just vps-deploy

# Status check (service + Tailscale)
status:
    @systemctl status creative-mode --no-pager 2>/dev/null || echo "creative-mode service: not found"
    @echo ""
    @tailscale status --peers=false 2>/dev/null || echo "Tailscale: not installed (local dev)"
