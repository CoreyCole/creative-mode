# Discord OAuth (required)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Discord Bot (optional — enables channel creation on world hatch)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WORLDS_CATEGORY_ID=

# Claude API (optional — if unset, /mayor shows "coming soon")
ANTHROPIC_API_KEY=

# Harness URL (optional — shown on world hatch card)
HARNESS_URL=https://claude-2.tailcdc985.ts.net

# Invite codes (required — comma-separated)
INVITE_CODES=test123,early-access
