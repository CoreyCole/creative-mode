package pages

import l "github.com/coreycole/creative-mode/site/layouts"

templ MayorPage(rootArgs l.RootArgs, messages []ChatMessage, devMode bool) {
	@l.Root(rootArgs) {
		<div class="flex flex-col h-[calc(100dvh-3.5rem)]">
			<!-- Compact header bar -->
			<div class="shrink-0 border-b border-border/40 px-4 py-3">
				<div class="mx-auto max-w-2xl">
					<div class="flex items-center justify-between">
						<h1 class="text-lg font-semibold">Meet the Mayor</h1>
						if devMode {
							<form action="/dev/reset-conversation" method="POST">
								<button type="submit" class="text-xs text-muted-foreground hover:text-foreground underline">
									Start Over (dev)
								</button>
							</form>
						}
					</div>
					<p class="text-sm text-muted-foreground">
						Tell the Mayor about your dream world. When it's ready, we'll create it for you.
					</p>
				</div>
			</div>
			<!-- Chat messages -->
			<div id="chat-messages" class="flex-1 min-h-0 overflow-y-auto space-y-3 px-4 py-4">
				for _, msg := range messages {
					if msg.Role == "assistant" {
						@MayorMessageComplete(msg.ID, msg.HTMLContent)
					} else if len(msg.ImageURLs) > 0 {
						@UserMessageWithImages(msg.ID, msg.Content, msg.AvatarURL, msg.ImageURLs)
					} else {
						@UserMessage(msg.ID, msg.Content, msg.AvatarURL)
					}
				}
				<!-- World hatched card placeholder -->
				<div id="mayor-signup"></div>
			</div>
			<!-- Input area -->
			<div class="shrink-0 border-t border-border/40 px-4 py-3 relative">
				<div class="mx-auto max-w-2xl">
					<!-- Rate limit error -->
					<div id="rate-limit-error"></div>
					<form
						id="chat-form"
						enctype="multipart/form-data"
						data-signals={ `{"mayor_input": "", "world_creating": false}` }
						class="flex flex-col gap-2"
					>
						<input type="hidden" name="create_world" value="false" id="create-world-flag"/>
						<div class="flex gap-2 items-end">
							<label
								title="Attach images (max 4, 5 MB each)"
								class="self-end inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input bg-background text-muted-foreground hover:text-foreground hover:bg-muted h-10 w-10 shrink-0 cursor-pointer"
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
									<circle cx="9" cy="9" r="2"></circle>
									<path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
								</svg>
								<input type="file" name="images" multiple accept="image/jpeg,image/png,image/gif,image/webp" class="hidden"/>
							</label>
							<span id="image-count" class="hidden self-end text-xs text-muted-foreground pb-2.5 whitespace-nowrap"></span>
							<textarea
								name="mayor_input"
								data-bind:mayor_input
								data-on:keydown={ `evt.key === 'Enter' && !evt.shiftKey && (evt.preventDefault(), !$_sending && !$world_creating && $mayor_input.trim() !== '' && @post('/mayor/chat', {contentType: 'form'}))` }
								data-attr:disabled="$_sending || $world_creating"
								placeholder="Type your message... (Shift+Enter for new line)"
								rows="1"
								class="flex-1 rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground placeholder-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary disabled:opacity-50 resize-none overflow-y-auto max-h-32"
								autocomplete="off"
							></textarea>
							<button
								type="button"
								data-on:click={ `!$_sending && !$world_creating && $mayor_input.trim() !== '' && @post('/mayor/chat', {contentType: 'form'})` }
								data-indicator:_sending
								data-attr:disabled="$_sending || $world_creating"
								class="self-end inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 disabled:opacity-50"
							>
								<span data-show="!$_sending">Send</span>
								<span data-show="$_sending" class="flex items-center gap-1.5">
									<span class="inline-block w-1.5 h-1.5 rounded-full bg-primary-foreground/70 animate-pulse"></span>
									Sending
								</span>
							</button>
						</div>
					</form>
				</div>
				<button
					type="button"
					data-on:click={ `$world_creating = true; document.getElementById('create-world-flag').value = 'true'; @post('/mayor/chat', {contentType: 'form', selector: '#chat-form'})` }
					data-indicator:_sending
					data-attr:disabled="$_sending || $world_creating"
					class="absolute right-4 bottom-3 inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-border bg-background text-foreground hover:bg-muted h-9 px-4 disabled:opacity-50"
				>
					Create World
				</button>
			</div>
			<script>
				// Scroll to bottom on page load to show latest messages.
				requestAnimationFrame(function () {
					var el = document.getElementById("chat-messages");
					if (el) {
						el.scrollTop = el.scrollHeight;
					}
				});
			</script>
			<script>
				// Auto-resize textarea as content grows.
				(function () {
					var ta = document.querySelector("textarea[data-bind\\:mayor_input]");
					if (!ta) return;
					function resize() {
						ta.style.height = "auto";
						ta.style.height = Math.min(ta.scrollHeight, 128) + "px";
					}
					ta.addEventListener("input", resize);
					new MutationObserver(function () {
						if (!ta.value) {
							ta.style.height = "auto";
						}
					}).observe(ta, { attributes: true });
				})();
			</script>
			<script>
				// Image count indicator + form reset cleanup.
				(function () {
					var form = document.getElementById("chat-form");
					var input = form && form.querySelector("input[name='images']");
					var badge = document.getElementById("image-count");
					var ta = document.querySelector("textarea[data-bind\\:mayor_input]");
					if (!form || !input || !badge) return;
					input.addEventListener("change", function () {
						var n = input.files ? input.files.length : 0;
						if (n > 0) {
							badge.textContent = n + " image" + (n > 1 ? "s" : "");
							badge.classList.remove("hidden");
						} else {
							badge.classList.add("hidden");
						}
					});
					form.addEventListener("reset", function () {
						badge.classList.add("hidden");
						badge.textContent = "";
						if (ta) {
							requestAnimationFrame(function () {
								ta.style.height = "auto";
							});
						}
					});
				})();
			</script>
		</div>
	}
}
