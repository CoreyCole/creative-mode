package swarm

import (
	"creative-mode/harness/internal/db/sqlc"
	"creative-mode/harness/internal/swarm"
	"creative-mode/harness/internal/swarmorch"
	"creative-mode/harness/views/layout"
	"database/sql"
	"fmt"
	"github.com/coreycole/datastarui/components/button"
	"github.com/starfederation/datastar-go/datastar"
	"strings"
)

type DashboardData struct {
	Workflows []sqlc.ListAllSwarmWorkflowsRow
	Events    []sqlc.SwarmEvent
	Metrics   *swarmorch.SwarmMetrics
	Health    *swarmorch.SwarmHealth
	Learnings []sqlc.SwarmLearning
	Digest    *sqlc.SwarmLearningDigest
}

type WorkflowDetailData struct {
	Workflow    sqlc.SwarmWorkflow
	Sessions    []sqlc.SwarmSession
	Events      []sqlc.SwarmEvent
	Milestones  []sqlc.SwarmProjectMilestone
	GateReviews []sqlc.SwarmGateReview
}

type DashboardSignals struct {
	ActiveTab string `json:"active_tab"`
}

func DefaultDashboardSignals() DashboardSignals {
	return DashboardSignals{ActiveTab: "workflows"}
}

templ Page(data DashboardData) {
	@layout.Base("Swarm Dashboard") {
		<div
			class="flex flex-col min-h-screen"
			data-signals={ templ.JSONString(DefaultDashboardSignals()) }
		>
			<header class="flex justify-between items-center px-6 py-3 border-b border-border bg-[#111]">
				<div class="flex items-center gap-3">
					<a href="/" class="text-muted-foreground hover:text-primary transition-colors text-sm">Creative Mode</a>
					<span class="text-muted-foreground">/</span>
					<h1 class="text-lg font-semibold">Swarm Dashboard</h1>
				</div>
			</header>
			<div class="flex border-b border-border bg-[#111]">
				@tabButton("workflows", "Workflows")
				@tabButton("metrics", "Metrics")
				@tabButton("learnings", "Learnings")
				@tabButton("events", "Events")
			</div>
			<div
				class="flex-1 p-6 overflow-y-auto"
				data-init={ datastar.GetSSE("/swarm/events") }
			>
				<div id="swarm-workflows-tab" data-show="$active_tab === 'workflows'">
					@WorkflowsTab(data.Workflows)
				</div>
				<div id="swarm-metrics-tab" data-show="$active_tab === 'metrics'" style="display: none;">
					@MetricsTab(data.Metrics, data.Health)
				</div>
				<div id="swarm-learnings-tab" data-show="$active_tab === 'learnings'" style="display: none;">
					@LearningsTab(data.Learnings, data.Digest)
				</div>
				<div id="swarm-events-tab" data-show="$active_tab === 'events'" style="display: none;">
					@EventsTab(data.Events)
				</div>
				<div id="swarm-tool-activity">
					<!-- Live tool activity feed populated via SSE -->
				</div>
			</div>
		</div>
	}
}

templ tabButton(id, label string) {
	@button.Button(button.ButtonArgs{
		Size:    "sm",
		Variant: "ghost",
		Attributes: templ.Attributes{
			"data-on:click": fmt.Sprintf("$active_tab = '%s'", id),
			"data-class":    fmt.Sprintf("{'bg-accent text-accent-foreground': $active_tab === '%s'}", id),
		},
	}) {
		{ label }
	}
}

templ WorkflowsTab(workflows []sqlc.ListAllSwarmWorkflowsRow) {
	<div class="space-y-3">
		if len(workflows) == 0 {
			<p class="text-muted-foreground">No workflows yet</p>
		}
		for _, wf := range workflows {
			@workflowRow(wf)
		}
	</div>
}

templ workflowRow(wf sqlc.ListAllSwarmWorkflowsRow) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/swarm/%s", wf.ID)) }
		class="block rounded-lg border border-border bg-card p-4 hover:bg-accent/50 transition-colors"
	>
		<div class="flex items-center justify-between mb-2">
			<div class="flex items-center gap-2">
				@statusBadge(wf.Status)
				@phaseBadge(wf.Phase)
				<span class="text-xs text-muted-foreground">{ string(wf.WorkflowType) }</span>
			</div>
			<span class="text-xs text-muted-foreground">{ wf.UpdatedAt }</span>
		</div>
		<div class="flex items-center justify-between">
			<div>
				<span class="text-sm font-medium">{ wf.TicketID }</span>
				<span class="text-xs text-muted-foreground ml-2">attempt { fmt.Sprintf("%d", wf.Attempt) }</span>
			</div>
			if wf.SessionID.Valid {
				<div class="flex items-center gap-2 text-xs text-muted-foreground">
					<span>{ wf.Skill.String }</span>
					if string(wf.Result) != "" {
						@resultBadge(wf.Result)
					}
				</div>
			}
		</div>
	</a>
}

templ EventsTab(events []sqlc.SwarmEvent) {
	<div class="space-y-2">
		if len(events) == 0 {
			<p class="text-muted-foreground">No events recorded</p>
		}
		for _, e := range events {
			@eventItem(e)
		}
	</div>
}

templ eventItem(e sqlc.SwarmEvent) {
	<div class="flex items-start gap-3 py-2 border-b border-border last:border-0">
		<span class={ "text-xs px-2 py-0.5 rounded whitespace-nowrap", eventTypeClass(e.EventType) }>
			{ string(e.EventType) }
		</span>
		<div class="flex-1 min-w-0">
			<span class="text-sm text-muted-foreground">{ e.TicketID }</span>
			if e.Phase.Valid {
				<span class="text-xs text-muted-foreground ml-2">{ e.Phase.String }</span>
			}
			if e.Detail.Valid {
				<p class="text-xs text-muted-foreground truncate mt-0.5">{ e.Detail.String }</p>
			}
		</div>
		<span class="text-xs text-muted-foreground whitespace-nowrap">{ e.CreatedAt }</span>
	</div>
}

templ WorkflowPage(data WorkflowDetailData) {
	@layout.Base("Workflow " + data.Workflow.ID) {
		<div class="flex flex-col min-h-screen">
			<header class="flex justify-between items-center px-6 py-3 border-b border-border bg-[#111]">
				<div class="flex items-center gap-3">
					<a href="/swarm" class="text-muted-foreground hover:text-primary transition-colors text-sm">Swarm</a>
					<span class="text-muted-foreground">/</span>
					<h1 class="text-lg font-semibold">{ shortID(data.Workflow.ID) }</h1>
					@statusBadge(data.Workflow.Status)
					@phaseBadge(data.Workflow.Phase)
				</div>
				<div class="flex items-center gap-3">
					<span class="text-sm text-muted-foreground">{ data.Workflow.TicketID }</span>
					if data.Workflow.Status == swarm.StatusRunning || data.Workflow.Status == swarm.StatusPending || data.Workflow.Status == swarm.StatusAwaitingReview {
						<button
							class="inline-flex items-center justify-center rounded-md border border-destructive bg-background shadow-xs hover:bg-destructive hover:text-destructive-foreground h-8 px-3 text-sm font-medium text-destructive"
							data-on:click={ datastar.PostSSE(fmt.Sprintf("/swarm/%s/cancel", data.Workflow.ID)) }
						>
							Cancel
						</button>
					}
				</div>
			</header>
			<div class="flex-1 p-6 overflow-y-auto space-y-6">
				<!-- Workflow info -->
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					@statCard("Type", string(data.Workflow.WorkflowType))
					@statCard("Attempt", fmt.Sprintf("%d", data.Workflow.Attempt))
					@statCard("Sessions", fmt.Sprintf("%d", len(data.Sessions)))
					@statCard("Events", fmt.Sprintf("%d", len(data.Events)))
				</div>
				if data.Workflow.BranchName.Valid {
					<div class="text-sm text-muted-foreground">
						Branch: <code class="bg-muted px-1.5 py-0.5 rounded text-xs">{ data.Workflow.BranchName.String }</code>
					</div>
				}
				<!-- Gate review panel -->
				if data.Workflow.Status == swarm.StatusAwaitingReview {
					<div class="rounded-lg border-2 border-purple-500/50 bg-purple-900/20 p-4" data-signals='{"reject_feedback": ""}'>
						<div class="flex items-center gap-2 mb-3">
							<span class="text-sm font-semibold text-purple-300">Awaiting Human Review</span>
							if data.Workflow.GatePhase.Valid {
								<span class="text-xs px-2 py-0.5 rounded bg-purple-900/50 text-purple-300">{ data.Workflow.GatePhase.String }</span>
							}
						</div>
						<div class="flex items-center gap-3 mb-3">
							<button
								class="inline-flex items-center justify-center rounded-md bg-green-700 hover:bg-green-600 text-white h-8 px-4 text-sm font-medium"
								data-on:click={ datastar.PostSSE(fmt.Sprintf("/swarm/%s/approve", data.Workflow.ID)) }
							>
								Approve
							</button>
						</div>
						<div class="space-y-2">
							<textarea
								class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm placeholder:text-muted-foreground"
								rows="3"
								placeholder="Rejection feedback (required)..."
								data-bind:reject_feedback
							></textarea>
							<button
								class="inline-flex items-center justify-center rounded-md bg-red-700 hover:bg-red-600 text-white h-8 px-4 text-sm font-medium"
								data-on:click={ datastar.PostSSE(fmt.Sprintf("/swarm/%s/reject", data.Workflow.ID)) }
							>
								Reject with Feedback
							</button>
						</div>
					</div>
				}
				<!-- Gate review history -->
				if len(data.GateReviews) > 0 {
					<div>
						<h2 class="text-sm font-semibold mb-3 text-muted-foreground">Gate Reviews</h2>
						<div class="space-y-2">
							for _, gr := range data.GateReviews {
								@gateReviewItem(gr)
							}
						</div>
					</div>
				}
				<!-- Sessions -->
				<div>
					<h2 class="text-sm font-semibold mb-3 text-muted-foreground">Sessions</h2>
					<div class="space-y-2">
						if len(data.Sessions) == 0 {
							<p class="text-muted-foreground text-sm">No sessions yet</p>
						}
						for _, s := range data.Sessions {
							@sessionItem(s)
						}
					</div>
				</div>
				<!-- Milestones -->
				if len(data.Milestones) > 0 {
					<div>
						<h2 class="text-sm font-semibold mb-3 text-muted-foreground">Milestones</h2>
						<div class="space-y-2">
							for _, m := range data.Milestones {
								@milestoneItem(m)
							}
						</div>
					</div>
				}
				<!-- Events -->
				<div>
					<h2 class="text-sm font-semibold mb-3 text-muted-foreground">Events</h2>
					<div class="space-y-2">
						if len(data.Events) == 0 {
							<p class="text-muted-foreground text-sm">No events yet</p>
						}
						for _, e := range data.Events {
							@eventItem(e)
						}
					</div>
				</div>
			</div>
		</div>
	}
}

// MetricsTab shows health status and aggregate metrics cards.
templ MetricsTab(metrics *swarmorch.SwarmMetrics, health *swarmorch.SwarmHealth) {
	<div class="space-y-6">
		if health != nil {
			@HealthStatus(health)
		}
		if metrics != nil {
			@MetricsCards(metrics)
		}
		if metrics == nil && health == nil {
			<p class="text-muted-foreground">No metrics data available. Start a workflow to begin collecting metrics.</p>
		}
	</div>
}

templ HealthStatus(health *swarmorch.SwarmHealth) {
	<div class="rounded-lg border border-border bg-card p-4">
		<div class="flex items-center justify-between mb-4">
			<h2 class="text-sm font-semibold text-muted-foreground">System Health</h2>
			@healthBadge(health.Status)
		</div>
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
			@statCard("Active Sessions", fmt.Sprintf("%d / %d", health.Capacity.ActiveSessions, health.Capacity.MaxSessions))
			@statCard("Completion Rate", fmt.Sprintf("%.0f%%", health.MetricsSummary.CompletionRate*100))
			@statCard("Total Workflows", fmt.Sprintf("%d", health.MetricsSummary.TotalWorkflows))
			@statCard("Total Sessions", fmt.Sprintf("%d", health.MetricsSummary.TotalSessions))
		</div>
		if len(health.ActiveWorkflows) > 0 {
			<div>
				<h3 class="text-xs font-semibold text-muted-foreground mb-2">Active Workflows</h3>
				<div class="space-y-1">
					for _, wf := range health.ActiveWorkflows {
						<div class="flex items-center justify-between text-xs py-1">
							<div class="flex items-center gap-2">
								<span class="font-medium">{ wf.TicketID }</span>
								<span class="text-muted-foreground">{ wf.Phase }</span>
								<span class="text-muted-foreground">attempt { fmt.Sprintf("%d", wf.Attempt) }</span>
							</div>
							<div class="flex items-center gap-2">
								if wf.Stalled {
									<span class="px-1.5 py-0.5 rounded bg-red-900/50 text-red-300 text-xs">stalled</span>
								}
								<span class="text-muted-foreground">{ wf.StartedAt }</span>
							</div>
						</div>
					}
				</div>
			</div>
		}
		if len(health.RecentCompletions) > 0 {
			<div class="mt-4">
				<h3 class="text-xs font-semibold text-muted-foreground mb-2">Recent Completions (24h)</h3>
				<div class="space-y-1">
					for _, c := range health.RecentCompletions {
						<div class="flex items-center justify-between text-xs py-1">
							<div class="flex items-center gap-2">
								<span class="font-medium">{ c.TicketID }</span>
								@statusBadge(swarm.WorkflowStatus(c.Status))
							</div>
							<span class="text-muted-foreground">{ c.UpdatedAt }</span>
						</div>
					}
				</div>
			</div>
		}
	</div>
}

templ MetricsCards(metrics *swarmorch.SwarmMetrics) {
	<div>
		<div class="flex items-center justify-between mb-3">
			<h2 class="text-sm font-semibold text-muted-foreground">Metrics ({ metrics.Period })</h2>
		</div>
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
			@statCard("Workflows", fmt.Sprintf("%d", metrics.Workflows.Total))
			@statCard("Completed", fmt.Sprintf("%d", metrics.Workflows.Completed))
			@statCard("Failed", fmt.Sprintf("%d", metrics.Workflows.Failed))
			@statCard("Running", fmt.Sprintf("%d", metrics.Workflows.Running))
		</div>
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
			@statCard("Sessions", fmt.Sprintf("%d", metrics.Sessions.Total))
			@statCard("Avg Duration", fmt.Sprintf("%.0fs", metrics.Sessions.AvgDurationSec))
			@statCard("Plan Revisions", fmt.Sprintf("%d", metrics.Retries.PlanRevisions))
			@statCard("Verify Retries", fmt.Sprintf("%d", metrics.Retries.VerifyRetries))
		</div>
		if len(metrics.Phases) > 0 {
			<div>
				<h3 class="text-xs font-semibold text-muted-foreground mb-2">Phase Breakdown</h3>
				<div class="grid grid-cols-2 md:grid-cols-3 gap-3">
					for phase, pm := range metrics.Phases {
						<div class="rounded-lg border border-border bg-card p-3">
							<div class="text-sm font-medium mb-1">{ phase }</div>
							<div class="text-xs text-muted-foreground space-y-0.5">
								<div>Count: { fmt.Sprintf("%d", pm.Count) }</div>
								<div>Avg: { fmt.Sprintf("%.0fs", pm.AvgDurationSec) }</div>
								<div>Fail rate: { fmt.Sprintf("%.0f%%", pm.FailureRate*100) }</div>
							</div>
						</div>
					}
				</div>
			</div>
		}
		if metrics.Learnings.Total > 0 {
			<div class="mt-4">
				<h3 class="text-xs font-semibold text-muted-foreground mb-2">Learning Counts</h3>
				<div class="flex gap-3 flex-wrap">
					for cat, count := range metrics.Learnings.ByCategory {
						<span class={ "text-xs px-2 py-1 rounded", categoryClass(swarm.LearningCategory(cat)) }>
							{ cat }: { fmt.Sprintf("%d", count) }
						</span>
					}
				</div>
			</div>
		}
	</div>
}

// LearningsTab shows recent learnings and the latest digest.
templ LearningsTab(learnings []sqlc.SwarmLearning, digest *sqlc.SwarmLearningDigest) {
	<div class="space-y-6">
		if digest != nil {
			@DigestCard(digest)
		}
		<div>
			<h2 class="text-sm font-semibold text-muted-foreground mb-3">Recent Learnings</h2>
			if len(learnings) == 0 {
				<p class="text-muted-foreground text-sm">No learnings captured yet.</p>
			}
			<div class="space-y-2">
				for _, l := range learnings {
					@learningItem(l)
				}
			</div>
		</div>
	</div>
}

templ DigestCard(digest *sqlc.SwarmLearningDigest) {
	<div class="rounded-lg border border-border bg-card p-4">
		<div class="flex items-center justify-between mb-2">
			<h2 class="text-sm font-semibold text-muted-foreground">Latest Digest</h2>
			<span class="text-xs text-muted-foreground">{ digest.CreatedAt }</span>
		</div>
		<div class="text-xs text-muted-foreground mb-2">
			{ fmt.Sprintf("%d learnings", digest.LearningCount) } — { digest.PeriodStart } to { digest.PeriodEnd }
		</div>
		if digest.ActionItems.Valid && digest.ActionItems.String != "" {
			<div class="mt-2">
				<h3 class="text-xs font-semibold text-muted-foreground mb-1">Action Items</h3>
				<div class="text-xs text-foreground whitespace-pre-wrap">{ digest.ActionItems.String }</div>
			</div>
		}
	</div>
}

templ learningItem(l sqlc.SwarmLearning) {
	<div class="rounded-lg border border-border bg-card p-3">
		<div class="flex items-center justify-between mb-1">
			<div class="flex items-center gap-2">
				@severityBadge(l.Severity)
				@categoryBadge(l.Category)
				if l.Phase.Valid {
					<span class="text-xs text-muted-foreground">{ l.Phase.String }</span>
				}
			</div>
			<span class="text-xs text-muted-foreground">{ l.CreatedAt }</span>
		</div>
		<div class="text-sm font-medium mb-0.5">{ l.Title }</div>
		<div class="text-xs text-muted-foreground">{ l.Content }</div>
		<div class="flex items-center gap-3 mt-1 text-xs text-muted-foreground">
			<span>{ l.TicketID }</span>
			<span>relevance: { fmt.Sprintf("%.2f", l.RelevanceScore) }</span>
			if l.Tags.Valid && l.Tags.String != "" {
				for _, tag := range splitTags(l.Tags.String) {
					<span class="px-1.5 py-0.5 rounded bg-muted text-muted-foreground">{ tag }</span>
				}
			}
		</div>
	</div>
}

// ToolActivityItem renders a single tool use event in the live feed.
templ ToolActivityItem(ticketID, phase, tool, file string) {
	<div class="flex items-center gap-2 text-xs py-1 border-b border-border last:border-0">
		<span class="px-1.5 py-0.5 rounded bg-blue-900/50 text-blue-300 whitespace-nowrap">tool_use</span>
		<span class="text-muted-foreground">{ ticketID }</span>
		<span class="text-muted-foreground">{ phase }</span>
		<span class="font-medium">{ tool }</span>
		if file != "" {
			<span class="text-muted-foreground truncate max-w-xs">{ file }</span>
		}
	</div>
}

templ sessionItem(s sqlc.SwarmSession) {
	<div class="rounded-lg border border-border bg-card p-3">
		<div class="flex items-center justify-between mb-1">
			<div class="flex items-center gap-2">
				@phaseBadge(s.Phase)
				<span class="text-sm font-medium">{ s.Skill }</span>
				if string(s.Result) != "" {
					@resultBadge(s.Result)
				}
			</div>
			<span class="text-xs text-muted-foreground">{ s.StartedAt }</span>
		</div>
		<div class="flex items-center gap-4 text-xs text-muted-foreground">
			if s.DurationSec.Valid {
				<span>{ fmt.Sprintf("%ds", s.DurationSec.Int64) }</span>
			}
			if s.TotalTokens.Valid {
				<span>{ fmt.Sprintf("%d tokens", s.TotalTokens.Int64) }</span>
			}
			if s.Detail.Valid {
				<span class="truncate max-w-md">{ s.Detail.String }</span>
			}
		</div>
	</div>
}

templ gateReviewItem(gr sqlc.SwarmGateReview) {
	<div class="flex items-start gap-3 py-2 border-b border-border last:border-0">
		if gr.Action == "approve" {
			<span class="text-xs px-2 py-0.5 rounded bg-green-900/50 text-green-300">approved</span>
		} else {
			<span class="text-xs px-2 py-0.5 rounded bg-red-900/50 text-red-300">rejected</span>
		}
		<div class="flex-1 min-w-0">
			<span class="text-sm">{ string(gr.GatePhase) }</span>
			if gr.Reviewer.Valid {
				<span class="text-xs text-muted-foreground ml-2">by { gr.Reviewer.String }</span>
			}
			if gr.Feedback.Valid && gr.Feedback.String != "" {
				<p class="text-xs text-muted-foreground mt-0.5">{ gr.Feedback.String }</p>
			}
		</div>
		<span class="text-xs text-muted-foreground whitespace-nowrap">{ gr.CreatedAt }</span>
	</div>
}

templ milestoneItem(m sqlc.SwarmProjectMilestone) {
	<div class="flex items-center gap-3 py-2 border-b border-border last:border-0">
		@milestoneBadge(m.Status)
		<div class="flex-1">
			<span class="text-sm font-medium">{ m.Name }</span>
			<p class="text-xs text-muted-foreground">{ m.Criteria }</p>
		</div>
		if m.VerifiedAt.Valid {
			<span class="text-xs text-muted-foreground">{ m.VerifiedAt.String }</span>
		}
	</div>
}

templ statCard(label, value string) {
	<div class="rounded-lg border border-border bg-card p-4">
		<div class="text-2xl font-bold">{ value }</div>
		<div class="text-sm text-muted-foreground">{ label }</div>
	</div>
}

templ statusBadge(status swarm.WorkflowStatus) {
	<span class={ "text-xs px-2 py-0.5 rounded-full", statusClass(status) }>
		{ string(status) }
	</span>
}

templ phaseBadge(phase swarm.Phase) {
	<span class={ "text-xs px-2 py-0.5 rounded", phaseClass(phase) }>
		{ string(phase) }
	</span>
}

templ resultBadge(result swarm.SessionResult) {
	<span class={ "text-xs px-2 py-0.5 rounded-full", resultClass(result) }>
		{ string(result) }
	</span>
}

templ milestoneBadge(status swarm.MilestoneStatus) {
	<span class={ "text-xs px-2 py-0.5 rounded-full", milestoneClass(status) }>
		{ string(status) }
	</span>
}

func shortID(id string) string {
	if len(id) > 8 {
		return id[:8]
	}
	return id
}

func statusClass(status swarm.WorkflowStatus) string {
	switch status {
	case swarm.StatusRunning:
		return "bg-yellow-900/50 text-yellow-300"
	case swarm.StatusComplete:
		return "bg-green-900/50 text-green-300"
	case swarm.StatusFailed:
		return "bg-red-900/50 text-red-300"
	case swarm.StatusCanceled:
		return "bg-muted text-muted-foreground"
	case swarm.StatusAwaitingReview:
		return "bg-purple-900/50 text-purple-300"
	default: // pending
		return "bg-blue-900/50 text-blue-300"
	}
}

func phaseClass(phase swarm.Phase) string {
	switch phase {
	case swarm.PhaseDone:
		return "bg-green-900/50 text-green-300"
	case swarm.PhaseFailed:
		return "bg-red-900/50 text-red-300"
	default:
		return "bg-muted text-muted-foreground"
	}
}

func resultClass(result swarm.SessionResult) string {
	switch result {
	case swarm.ResultSuccess:
		return "bg-green-900/50 text-green-300"
	case swarm.ResultLogicFailure:
		return "bg-red-900/50 text-red-300"
	case swarm.ResultInfraFailure:
		return "bg-orange-900/50 text-orange-300"
	case swarm.ResultTimeout, swarm.ResultContextLimit:
		return "bg-yellow-900/50 text-yellow-300"
	default:
		return "bg-muted text-muted-foreground"
	}
}

func milestoneClass(status swarm.MilestoneStatus) string {
	switch status {
	case swarm.MilestoneStatusPassed:
		return "bg-green-900/50 text-green-300"
	case swarm.MilestoneStatusFailed:
		return "bg-red-900/50 text-red-300"
	default: // pending
		return "bg-blue-900/50 text-blue-300"
	}
}

func eventTypeClass(_ swarm.EventType) string {
	return "bg-muted text-muted-foreground"
}

templ healthBadge(status string) {
	<span class={ "text-xs px-2 py-0.5 rounded-full", healthClass(status) }>
		{ status }
	</span>
}

func healthClass(status string) string {
	switch status {
	case swarmorch.HealthStatusHealthy:
		return "bg-green-900/50 text-green-300"
	case swarmorch.HealthStatusDegraded:
		return "bg-yellow-900/50 text-yellow-300"
	case swarmorch.HealthStatusUnhealthy:
		return "bg-red-900/50 text-red-300"
	default:
		return "bg-muted text-muted-foreground"
	}
}

templ severityBadge(severity swarm.LearningSeverity) {
	<span class={ "text-xs px-2 py-0.5 rounded-full", severityClass(severity) }>
		{ string(severity) }
	</span>
}

func severityClass(severity swarm.LearningSeverity) string {
	switch severity {
	case swarm.SeverityCritical:
		return "bg-red-900/50 text-red-300"
	case swarm.SeverityWarning:
		return "bg-yellow-900/50 text-yellow-300"
	default: // info
		return "bg-blue-900/50 text-blue-300"
	}
}

templ categoryBadge(category swarm.LearningCategory) {
	<span class={ "text-xs px-2 py-0.5 rounded", categoryClass(category) }>
		{ string(category) }
	</span>
}

func categoryClass(category swarm.LearningCategory) string {
	switch category {
	case swarm.LearningPostMortem:
		return "bg-red-900/50 text-red-300"
	case swarm.LearningCodeBug:
		return "bg-orange-900/50 text-orange-300"
	case swarm.LearningPlanIssue:
		return "bg-yellow-900/50 text-yellow-300"
	case swarm.LearningConvention:
		return "bg-purple-900/50 text-purple-300"
	default: // pattern
		return "bg-muted text-muted-foreground"
	}
}

func splitTags(tags string) []string {
	var result []string
	for _, t := range strings.Split(tags, ",") {
		t = strings.TrimSpace(t)
		if t != "" {
			result = append(result, t)
		}
	}
	return result
}

// Suppress unused import warnings.
var _ = sql.NullString{}
var _ = swarmorch.HealthStatusHealthy
