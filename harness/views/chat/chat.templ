package chat

import "creative-mode/harness/views/shared"

// ChatPanel renders the tabbed chat UI for the world overlay.
templ ChatPanel() {
	<div class="chat-panel">
		<div class="tab-bar">
			<button data-on-click={ CE.SelectTab("global") }
				data-class={ CE.TabActiveClass("global") }>Global</button>
			<button data-on-click={ CE.SelectTab("world") }
				data-class={ CE.TabActiveClass("world") }>World</button>
			<button data-on-click={ CE.SelectLineageTab() }
				data-class={ CE.TabActiveClass("lineage") }>Lineage</button>
		</div>
		<div id="chat-log" class="message-log"></div>
		<div id="lineage-view" class="message-log" data-show="$active_tab === 'lineage'" style="display: none;"></div>
		<div class="chat-input-bar" data-show="$active_tab !== 'lineage'">
			@ChatInputBar()
		</div>
	</div>
}

// Message is an SSE fragment for an individual chat message (appended to #chat-log).
templ Message(username, avatarURL, content, timestamp string) {
	<div class="message chat-message">
		if avatarURL != "" {
			<img src={ avatarURL } class="avatar-xs" alt=""/>
		}
		<span class="username">{ username }</span>
		<span class="content">{ content }</span>
		<time class="ts">{ timestamp }</time>
	</div>
}

// SystemNotification is an SSE fragment for system notifications.
templ SystemNotification(content string) {
	<div class="message system-notification">
		<span class="sys-badge">[sys]</span>
		<span class="content">{ content }</span>
	</div>
}

// BuildReadyNotification is an SSE fragment for build completion with a play button.
templ BuildReadyNotification(worldID, cpID, worldName string) {
	<div class="message system-notification build-ready">
		<span class="sys-badge">[build]</span>
		<span class="content">Build ready in { worldName }</span>
		@shared.LoadCheckpointButton(worldID, cpID, "Play", "play-btn")
	</div>
}
