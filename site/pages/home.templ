package pages

import l "github.com/coreycole/creative-mode/site/layouts"

templ HomePage(rootArgs l.RootArgs) {
	@l.Root(rootArgs) {
		<!-- Hero Section -->
		<section class="py-20 md:py-32">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
				<h1 class="text-4xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
					Meet the Mayor
					<br/>
					<span class="text-muted-foreground">Built by Conversation</span>
				</h1>
				<p class="mt-6 text-lg text-muted-foreground max-w-2xl mx-auto">
					An infinite sandbox where any idea becomes a reality.
				</p>
				<p class="mt-1 text-lg text-muted-foreground max-w-2xl mx-auto">
					Chat from anywhere, play in your browser on a shared, secured server.
				</p>
				<div class="mt-10 flex items-center justify-center gap-4">
					<a
						href="https://github.com/coreycole/creative-mode"
						class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8"
					>
						Meet the Mayor
					</a>
					<a
						href="https://discord.gg/cPtN5vP3ty"
						target="_blank"
						rel="noreferrer"
						class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-11 px-8"
					>
						Join Discord
					</a>
				</div>
			</div>
		</section>
		<!-- Features Section -->
		<section class="py-20 border-t border-border/40">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-3xl font-bold tracking-tight text-center sm:text-4xl">
					An infinite sandbox, built by conversation
				</h2>
				<p class="mt-4 text-lg text-muted-foreground text-center max-w-2xl mx-auto">
					The Mayor learns your world inside and out. Friends make it richer.
				</p>
				<div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
					<!-- Feature 1: Infinite Sandbox -->
					<div class="rounded-lg border border-border/40 bg-card p-6">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z"></path>
							</svg>
						</div>
						<h3 class="mt-4 text-lg font-semibold">Infinite Sandbox</h3>
						<p class="mt-2 text-sm text-muted-foreground">
							Any idea can become a reality. A forest, a racing game, a puzzle — if you can describe it, you can play it.
						</p>
					</div>
					<!-- Feature 2: Chat from Discord -->
					<div class="rounded-lg border border-border/40 bg-card p-6">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"></path>
							</svg>
						</div>
						<h3 class="mt-4 text-lg font-semibold">Chat from Anywhere</h3>
						<p class="mt-2 text-sm text-muted-foreground">
							Message the Mayor from Discord, your phone, or your browser. Every conversation makes it smarter about your world.
						</p>
					</div>
					<!-- Feature 3: Living Lore -->
					<div class="rounded-lg border border-border/40 bg-card p-6">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
							</svg>
						</div>
						<h3 class="mt-4 text-lg font-semibold">Living Lore</h3>
						<p class="mt-2 text-sm text-muted-foreground">
							The Mayor remembers everything — characters, places, history. Your world's lore deepens with every chat.
						</p>
					</div>
					<!-- Feature 4: Learns on the Job -->
					<div class="rounded-lg border border-border/40 bg-card p-6">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path>
								<path d="M9 18h6"></path>
								<path d="M10 22h4"></path>
							</svg>
						</div>
						<h3 class="mt-4 text-lg font-semibold">Learns on the Job</h3>
						<p class="mt-2 text-sm text-muted-foreground">
							The Mayor starts as a blank slate. Ask it to build a tavern, then a quest — it connects the dots and builds on what came before.
						</p>
					</div>
					<!-- Feature 5: World Hop -->
					<div class="rounded-lg border border-border/40 bg-card p-6">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M5 12h14"></path>
								<path d="m12 5 7 7-7 7"></path>
							</svg>
						</div>
						<h3 class="mt-4 text-lg font-semibold">World Hop</h3>
						<p class="mt-2 text-sm text-muted-foreground">
							Jump on the server with friends. Hop between each other's worlds, combine the best mechanics, build something none of you could alone.
						</p>
					</div>
					<!-- Feature 6: Open Source -->
					<div class="rounded-lg border border-border/40 bg-card p-6">
						<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="16 18 22 12 16 6"></polyline>
								<polyline points="8 6 2 12 8 18"></polyline>
							</svg>
						</div>
						<h3 class="mt-4 text-lg font-semibold">Open Source</h3>
						<p class="mt-2 text-sm text-muted-foreground">
							Free to use, fork, and customize. Build your own creative platform on top.
						</p>
					</div>
				</div>
			</div>
		</section>
		<!-- CTA Section -->
		<section class="py-20 border-t border-border/40">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
					Start Building
				</h2>
				<p class="mt-4 text-lg text-muted-foreground max-w-xl mx-auto">
					The Mayor is ready. Bring friends, combine ideas, and build something nobody's seen before.
				</p>
				<div class="mt-10">
					<a
						href="https://github.com/coreycole/creative-mode"
						class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8"
					>
						Meet the Mayor
					</a>
				</div>
			</div>
		</section>
	}
}
