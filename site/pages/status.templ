package pages

import (
	"github.com/starfederation/datastar-go/datastar"

	selectui "github.com/coreycole/creative-mode/site/internal/ui/select"
	l "github.com/coreycole/creative-mode/site/layouts"
)

templ StatusPage(rootArgs l.RootArgs, showHarness bool, showWorlds bool) {
	@l.Root(rootArgs) {
		<section class="py-12 md:py-20">
			<div
				class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8"
				data-init={ datastar.GetSSE("/status/events") }
				data-signals="{memTotal:'',memUsed:'',memUsedPercent:'',cpuPercent:'',uptime:'',diskTotal:'',diskUsed:'',diskUsedPercent:''}"
			>
				<!-- Metrics Graph -->
				<div class="mb-6">
					<div class="flex items-center justify-between mb-2">
						<h2 class="text-lg font-semibold text-foreground">Metrics</h2>
						@selectui.Select(selectui.SelectArgs{
							ID:          "graphRange",
							Placeholder: "1h",
							OnChange:    "@post('/status/graph')",
							Options: []selectui.SelectOption{
								{Value: "1h", Label: "1h"},
								{Value: "6h", Label: "6h"},
								{Value: "24h", Label: "24h"},
								{Value: "7d", Label: "7d"},
							},
						})
					</div>
					<div id="metrics-graph">
						@MetricsGraph(GraphData{})
					</div>
				</div>
				<!-- Site Stats -->
				<div class="mb-6">
					<h2 class="text-lg font-semibold text-foreground mb-4">Site Stats</h2>
					<div id="stats-overview">
						@StatsOverview(0, 0, 0, 0)
					</div>
				</div>
				<!-- System Metrics -->
				<div class="mb-6">
					<h2 class="text-lg font-semibold text-foreground mb-4">System</h2>
					<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
						@metricCard("CPU", "$cpuPercent")
						@metricCard("Memory Used", "$memUsed")
						@metricCard("Memory %", "$memUsedPercent")
						@metricCard("Total Memory", "$memTotal")
						@metricCard("Uptime", "$uptime")
						@metricCard("Disk Used", "$diskUsed")
						@metricCard("Disk %", "$diskUsedPercent")
						@metricCard("Total Disk", "$diskTotal")
					</div>
				</div>
				<!-- Database -->
				<div class="mb-6">
					<h2 class="text-lg font-semibold text-foreground mb-4">Database</h2>
					<div id="db-health">
						@DBHealthCard("checking", "", 0)
					</div>
				</div>
				<!-- Harness Health -->
				if showHarness {
					<div class="mb-6" id="harness-health">
						@HarnessHealthCard("checking", "", "")
					</div>
				}
				<!-- World Status -->
				if showWorlds {
					<div class="mb-6" id="world-status">
						@WorldStatusTable(nil, "")
					</div>
				}
			</div>
		</section>
	}
}

templ metricCard(label string, signalExpr string) {
	<div class="rounded-lg border border-border bg-card p-4">
		<p class="text-xs font-medium text-muted-foreground uppercase tracking-wider">{ label }</p>
		<p class="mt-1 text-xl font-semibold text-foreground">
			<span data-text={ signalExpr } class="tabular-nums">--</span>
		</p>
	</div>
}
