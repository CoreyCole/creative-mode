package layouts

templ ChatLayout(args RootArgs) {
	<!DOCTYPE html>
	<html lang="en">
		@Head(args)
		<body class="bg-background font-sans antialiased overscroll-none" data-signals="{theme: initTheme()}">
			<div class="fixed inset-0 flex flex-col overflow-hidden bg-background">
				@Header(args)
				{ children... }
			</div>
		</body>
	</html>
}
