package pending

import (
	"creative-mode/harness/internal/db/sqlc"
	"creative-mode/harness/views/layout"
)

templ Page(user *sqlc.User) {
	@layout.Base("Pending Approval") {
		<div class="flex flex-col items-center justify-center min-h-screen gap-4">
			if user.AvatarURL.Valid {
				<img src={ user.AvatarURL.String } class="w-16 h-16 rounded-full" alt="avatar"/>
			}
			<h2>Welcome, { user.GitHubUsername }</h2>
			<p class="text-muted-foreground">Your request to join has been submitted. An admin will approve your access.</p>
		</div>
	}
}
