package pages

// MayorMessageComplete renders a completed assistant message with pre-rendered HTML.
templ MayorMessageComplete(msgID string, htmlContent string) {
	<div id={ "msg-" + msgID } class="max-w-2xl mx-auto flex items-end gap-2 justify-start">
		<img src="/img/square-meme-bg.jpeg" alt="Mayor" class="w-8 h-8 rounded-full shrink-0 object-cover"/>
		<div class="max-w-[85%]">
			<div class="rounded-2xl rounded-bl-sm bg-muted px-4 py-3">
				<div id={ "msg-content-" + msgID } class="chat-message-content">
					@templ.Raw(htmlContent)
				</div>
			</div>
		</div>
	</div>
}

// MayorMessageStreaming renders an empty assistant message placeholder during streaming.
templ MayorMessageStreaming(msgID string) {
	<div id={ "msg-" + msgID } class="max-w-2xl mx-auto flex items-end gap-2 justify-start">
		<img src="/img/square-meme-bg.jpeg" alt="Mayor" class="w-8 h-8 rounded-full shrink-0 object-cover"/>
		<div class="max-w-[85%]">
			<div class="rounded-2xl rounded-bl-sm bg-muted px-4 py-3">
				<div id={ "msg-content-" + msgID } class="chat-message-content">
					<span class="inline-block w-2 h-5 bg-foreground/50 rounded-sm animate-pulse"></span>
				</div>
			</div>
		</div>
	</div>
}

// MayorMessageDelta renders streaming text content (plain text, pre-markdown).
templ MayorMessageDelta(msgID string, text string) {
	<span class="whitespace-pre-wrap">{ text }</span>
}

// MayorMessageDeltaHTML renders streaming content with partially rendered markdown.
templ MayorMessageDeltaHTML(msgID string, htmlContent string) {
	@templ.Raw(htmlContent)
}

// UserMessage renders a user message with the user's Discord avatar.
templ UserMessage(msgID string, content string, avatarURL string) {
	<div id={ "msg-" + msgID } class="max-w-2xl mx-auto flex items-end gap-2 justify-end">
		<div class="max-w-[85%] rounded-2xl rounded-br-sm bg-primary text-primary-foreground px-4 py-3">
			<p class="text-sm whitespace-pre-wrap">{ content }</p>
		</div>
		if avatarURL != "" {
			<img src={ avatarURL } alt="You" class="w-8 h-8 rounded-full shrink-0 object-cover"/>
		} else {
			<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/20 text-primary text-xs font-bold">
				U
			</div>
		}
	</div>
}

// WorldHatched is shown after the Discord channel is created.
templ WorldHatched(worldName, mayorName, discordChannelURL, discordUsername, discordAvatar, harnessURL string) {
	<div id="mayor-signup" class="mx-auto max-w-2xl my-6 rounded-lg border border-border/40 bg-card p-6 text-center">
		<h2 class="text-xl font-bold">{ worldName } Has Been Born</h2>
		<p class="mt-3 text-muted-foreground">
			<strong>{ mayorName }</strong> is ready and waiting for you.
		</p>
		<div class="mt-4 flex items-center justify-center gap-3">
			if discordAvatar != "" {
				<img src={ discordAvatar } alt={ discordUsername } class="w-10 h-10 rounded-full"/>
			}
			<span class="text-sm font-medium">{ discordUsername }</span>
		</div>
		<div class="mt-6 flex flex-col items-center gap-3">
			if harnessURL != "" {
				<a
					href={ templ.SafeURL(harnessURL) }
					target="_blank"
					rel="noreferrer"
					class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8"
				>
					Enter Your World
				</a>
			}
			if discordChannelURL != "" {
				<a
					href={ templ.SafeURL(discordChannelURL) }
					target="_blank"
					rel="noreferrer"
					if harnessURL != "" {
						class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-border bg-background text-foreground hover:bg-muted h-11 px-8"
					} else {
						class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8"
					}
				>
					Open Your World in Discord
				</a>
			}
		</div>
		if discordChannelURL != "" {
			<p class="mt-3 text-sm text-muted-foreground">
				Just type in the channel — { mayorName } is always listening.
			</p>
		} else if harnessURL == "" {
			<p class="mt-4 text-sm text-muted-foreground">
				Your world is ready! Join the Discord server to get started.
			</p>
		}
	</div>
}

// WorldSummaryCard is shown when Discord bot token is not configured (no channel creation).
templ WorldSummaryCard(worldName, mayorName, summary string) {
	<div id="mayor-signup" class="mx-auto max-w-2xl my-6 rounded-lg border border-border/40 bg-card p-6 text-center">
		<h2 class="text-xl font-bold">{ worldName } Has Been Born</h2>
		<p class="mt-3 text-muted-foreground">
			<strong>{ mayorName }</strong> — { summary }
		</p>
		<a
			href="https://discord.gg/cPtN5vP3ty"
			target="_blank"
			rel="noreferrer"
			class="mt-6 inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8"
		>
			Join Discord to Get Started
		</a>
	</div>
}

// RateLimitError shows a rate limit message to the user.
templ RateLimitError() {
	<div id="rate-limit-error" class="mt-2 text-sm text-destructive text-center">
		Please wait a moment before sending another message.
	</div>
}

// RateLimitClear clears any existing rate limit error.
templ RateLimitClear() {
	<div id="rate-limit-error"></div>
}
