package imagegen

import (
	"github.com/coreycole/datastarui/components/button"
	"github.com/coreycole/datastarui/components/input"
	"github.com/starfederation/datastar-go/datastar"
)

// ImageGenPanel is the main content area for the Image tab.
templ ImageGenPanel() {
	<div id="image-gen-view" class="flex-1 overflow-y-auto px-3 py-2 flex flex-col gap-3" data-show="$active_tab === 'image'" style="display: none;">
		<!-- Aspect Ratio Selector -->
		<div class="flex flex-col gap-1.5">
			<span class="text-[11px] text-muted-foreground uppercase tracking-wider">Aspect Ratio</span>
			<div class="flex gap-1">
				for _, ratio := range []string{"1:1", "16:9", "4:3", "3:4", "9:16"} {
					<button
						class="px-2 py-1 text-[11px] rounded cursor-pointer border-0"
						data-on:click={ IE.SelectAspectRatio(ratio) }
						data-class={ IE.AspectRatioActiveClass(ratio) }
					>
						{ ratio }
					</button>
				}
			</div>
		</div>
		<!-- Preview Area -->
		<div class="flex flex-col gap-2 items-center">
			<div data-show="$image_gen_status === 'generating'" style="display: none;" class="flex flex-col items-center gap-2 py-8">
				<div class="w-6 h-6 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
				<span class="text-[12px] text-muted-foreground">Generating image...</span>
			</div>
			<div data-show="$image_preview_url !== ''" style="display: none;" class="relative">
				<img
					data-attr-src="$image_preview_url"
					class="max-w-full rounded border border-border"
					alt="Generated image preview"
				/>
			</div>
			<!-- Download: unsaved preview -->
			<a data-show="$image_gen_status === 'done' && $image_preview_url !== ''" style="display: none;"
				data-attr-href="$image_preview_url"
				download="generated-image.png"
				class="text-[11px] text-primary hover:underline cursor-pointer">
				Download
			</a>
			<!-- Download: saved asset -->
			<a data-show="$image_gen_status === 'saved' && $image_saved_path !== ''" style="display: none;"
				data-attr-href="'/assets/' + $image_saved_path"
				data-attr-download="$image_saved_path.split('/').pop()"
				class="text-[11px] text-primary hover:underline cursor-pointer">
				Download
			</a>
			<div data-show="$image_gen_status === 'idle'" style="display: none;" class="py-8 text-center">
				<span class="text-[12px] text-muted-foreground">Describe an image to generate</span>
			</div>
		</div>
		<!-- Status -->
		<div data-show="$image_gen_status !== 'idle'" style="display: none;" class="text-[12px]">
			<span data-class={ IE.StatusColorClass() } data-text={
				"$image_gen_status === 'generating' ? 'Generating...' : " +
				"$image_gen_status === 'done' ? 'Done — click Save to keep' : " +
				"$image_gen_status === 'saved' ? 'Saved!' : " +
				"$image_gen_status === 'error' ? $image_error_msg : " +
				"$image_gen_status" }></span>
		</div>
		<!-- Saved Path -->
		<div data-show="$image_gen_status === 'saved' && $image_saved_path !== ''" style="display: none;"
			class="bg-green-950/50 border border-green-800 rounded px-2 py-1.5 text-[12px] text-green-300 font-mono select-all">
			<span data-text="$image_saved_path"></span>
		</div>
	</div>
}

// ImageGenInputBar is the bottom input bar for the Image tab.
templ ImageGenInputBar() {
	@input.Input(input.InputArgs{
		Placeholder: "Describe an image...",
		Class:       "flex-1 h-8 text-[13px]",
		Attributes:  templ.Attributes{"data-bind:image_prompt": true},
	})
	@button.Button(button.ButtonArgs{
		Size: "sm",
		Attributes: templ.Attributes{
			"data-on:click":           datastar.PostSSE("/api/images/generate"),
			"data-indicator-fetching": true,
			"data-attr-disabled":      "$fetching || $image_gen_status === 'generating'",
		},
	}) {
		Generate
	}
	<div data-show="$image_gen_status === 'done'" style="display: none;">
		@button.Button(button.ButtonArgs{
			Size:    "sm",
			Variant: "outline",
			Attributes: templ.Attributes{
				"data-on:click":           datastar.PostSSE("/api/images/save"),
				"data-indicator-fetching": true,
				"data-attr-disabled":      "$fetching",
			},
		}) {
			Save
		}
	</div>
}
