package pages

import l "github.com/coreycole/creative-mode/site/layouts"

templ JoinDiscordPage(rootArgs l.RootArgs, errorMsg string) {
	@l.Root(rootArgs) {
		<section class="py-20 md:py-32">
			<div class="mx-auto max-w-md px-4 sm:px-6 lg:px-8">
				<div class="rounded-lg border border-border/40 bg-card p-8">
					<h1 class="text-2xl font-bold text-center">Join the Discord</h1>
					<p class="mt-2 text-sm text-muted-foreground text-center">
						Creative Mode is in early access. Join our Discord server to get started.
					</p>
					<div class="mt-6 space-y-4">
						<a
							href="https://discord.gg/cPtN5vP3ty"
							target="_blank"
							rel="noopener noreferrer"
							class="w-full inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-[#5865F2] text-white hover:bg-[#4752C4] h-10 px-4"
						>
							Join Discord Server
						</a>
						<form method="POST" action="/join-discord" class="space-y-3">
							if errorMsg != "" {
								<p class="text-sm text-destructive">{ errorMsg }</p>
							}
							<button
								type="submit"
								class="w-full inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4"
							>
								I've joined, check again
							</button>
						</form>
					</div>
				</div>
			</div>
		</section>
	}
}
