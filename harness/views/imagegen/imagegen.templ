package imagegen

import (
	"github.com/coreycole/datastarui/components/button"
	"github.com/coreycole/datastarui/components/input"
	"github.com/starfederation/datastar-go/datastar"
)

// ImageGenPanel is the main content area for the Image tab.
templ ImageGenPanel() {
	<div id="image-gen-view" class="flex-1 overflow-y-auto px-3 py-2 flex flex-col gap-3" data-show="$active_tab === 'assets'" style="display: none;">
		<!-- Aspect Ratio Selector -->
		<div class="flex flex-col gap-1.5">
			<span class="text-[11px] text-muted-foreground uppercase tracking-wider">Aspect Ratio</span>
			<div class="flex gap-1">
				for _, ratio := range []string{"1:1", "16:9", "4:3", "3:4", "9:16"} {
					<button
						class="px-2 py-1 text-[11px] rounded cursor-pointer border-0"
						data-on:click={ IE.SelectAspectRatio(ratio) }
						data-class={ IE.AspectRatioActiveClass(ratio) }
					>
						{ ratio }
					</button>
				}
			</div>
		</div>
		<!-- Transparent Background Toggle -->
		<label class="flex items-center gap-2 cursor-pointer">
			<input
				type="checkbox"
				class="w-3.5 h-3.5 accent-primary cursor-pointer"
				data-bind:image_transparent_bg
			/>
			<span class="text-[11px] text-muted-foreground">Transparent background (for sprites)</span>
		</label>
		<!-- Input + Generate -->
		<div class="flex gap-1.5">
			@ImageGenInputBar()
		</div>
		<!-- Dynamic Content Area (replaced by server fragments) -->
		<div id="image-gen-content"></div>
		<!-- Asset File Tree (loaded via SSE, refreshed after save) -->
		<div id="asset-tree" class="border-t border-border pt-3">
			<span class="text-[11px] text-muted-foreground">Loading assets...</span>
		</div>
	</div>
}

// ImageGenIdle is the initial placeholder state.
templ ImageGenIdle() {
	<div id="image-gen-content" class="flex flex-col gap-2 items-center py-8 text-center">
		<span class="text-[12px] text-muted-foreground">Describe an image to generate</span>
	</div>
}

// ImageGenGenerating shows a spinner during generation.
templ ImageGenGenerating() {
	<div id="image-gen-content" class="flex flex-col items-center gap-2 py-8">
		<div class="w-6 h-6 border-2 border-primary border-t-transparent rounded-full animate-spin"></div>
		<span class="text-[12px] text-muted-foreground">Generating image...</span>
	</div>
}

// ImageGenDone shows the preview with download and save actions.
templ ImageGenDone(genID, previewURL string) {
	<div
		id="image-gen-content"
		class="flex flex-col gap-2 items-center"
		data-signals__ifmissing={ `{"image_gen_id":"` + genID + `"}` }
	>
		<div class="relative">
			<img
				src={ previewURL }
				class="max-w-full rounded border border-border"
				alt="Generated image preview"
			/>
		</div>
		<div class="flex items-center gap-3">
			<a
				href={ templ.SafeURL(previewURL) }
				download="generated-image.png"
				class="text-[11px] text-primary hover:underline cursor-pointer"
			>
				Download
			</a>
			@button.Button(button.ButtonArgs{
				Size:    "sm",
				Variant: "outline",
				Attributes: templ.Attributes{
					"data-on:click":           datastar.PostSSE("/api/images/save"),
					"data-indicator-fetching": true,
					"data-attr-disabled":      "$fetching",
				},
			}) {
				Save
			}
		</div>
	</div>
}

// ImageGenSaved shows the saved image with its asset path.
templ ImageGenSaved(savedPath string) {
	<div id="image-gen-content" class="flex flex-col gap-2 items-center">
		<div class="relative">
			<img
				src={ "/assets/" + savedPath }
				class="max-w-full rounded border border-border"
				alt="Saved image"
			/>
		</div>
		<a
			href={ templ.SafeURL("/assets/" + savedPath) }
			download
			class="text-[11px] text-primary hover:underline cursor-pointer"
		>
			Download
		</a>
		<div class="text-[12px] text-green-400">Saved!</div>
		<div class="bg-green-950/50 border border-green-800 rounded px-2 py-1.5 text-[12px] text-green-300 font-mono select-all w-full text-center">
			{ savedPath }
		</div>
	</div>
}

// ImageGenError shows an error message.
templ ImageGenError(message string) {
	<div id="image-gen-content" class="flex flex-col gap-2 items-center py-4">
		<span class="text-[12px] text-red-400">{ message }</span>
	</div>
}

// ImageGenInputBar is the bottom input bar for the Image tab.
templ ImageGenInputBar() {
	@input.Input(input.InputArgs{
		Placeholder: "Describe an image...",
		Class:       "flex-1 h-8 text-[13px]",
		Attributes:  templ.Attributes{"data-bind:image_prompt": true},
	})
	@button.Button(button.ButtonArgs{
		Size: "sm",
		Attributes: templ.Attributes{
			"data-on:click":           datastar.PostSSE("/api/images/generate"),
			"data-indicator-fetching": true,
			"data-attr-disabled":      "$fetching",
		},
	}) {
		Generate
	}
}
