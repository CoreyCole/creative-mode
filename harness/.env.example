# Discord OAuth (required for authentication)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Bot (required for mayors + Discord listener)
# Single bot token shared across all Discord operations
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_WORLDS_CATEGORY_ID=

# Discord President channel (optional — enables president agent)
# DISCORD_PRESIDENT_CHANNEL_ID=

# GitHub OAuth (optional — for future account linking)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Gemini API key (optional — enables AI image generation)
# GEMINI_API_KEY=

# Anthropic API key (required for Claude Code sessions + OpenClaw agents)
ANTHROPIC_API_KEY=

# President secret (optional — enables president agent API)
# PRESIDENT_SECRET=

# Dev mode — enables hot-reload endpoints, dev auth fallback, disables asset caching.
# Docker Compose sets this automatically. Leave unset on VPS for production behavior.
# DEV_MODE=true

# --- VPS only (not needed for local dev) ---

# Harness URL — set to your Tailscale Serve URL on the VPS.
# Enables Secure cookies and HSTS. Leave unset for local dev (defaults to http://localhost:8080).
# HARNESS_URL=https://your-machine.tailnet-name.ts.net

# Hook secret — protects /api/claude-event and /api/world-hatched endpoints.
# Must match CM_HOOK_SECRET in site.env. Generate with: openssl rand -hex 32
# CM_HOOK_SECRET=

# OpenClaw data directory (default: data/openclaw)
# OPENCLAW_HOME=/home/deploy/creative-mode/data/openclaw
