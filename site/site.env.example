# Creative Mode Site — Environment Variables
# Copy to ~/.config/creative-mode/site.env and chmod 600

# --- Webhook (self-rebuild on GitHub push) ---
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# --- Discord Bot (world channel creation) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WORLDS_CATEGORY_ID=

# --- Anthropic (mayor onboarding) ---
ANTHROPIC_API_KEY=

# --- Gemini (cover art generation, optional) ---
GEMINI_API_KEY=

# --- Invite codes (comma-separated) ---
INVITE_CODES=

# --- Harness URL (optional — shown on world hatch card) ---
HARNESS_URL=https://claude-2.tailcdc985.ts.net

# --- Hook secret (site → harness world-hatched webhook) ---
# Must match CM_HOOK_SECRET in harness .env
# CM_HOOK_SECRET=

# --- Database (optional, default: data/site.db) ---
# SITE_DB_PATH=data/site.db

# --- Dev mode (enables /dev/auth/login route) ---
# DEV_MODE=true

# --- Port (default 80) ---
# PORT=80
