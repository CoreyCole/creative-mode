package world

import (
	"fmt"
	"creative-mode/harness/internal/db/sqlc"
	"creative-mode/harness/views/chat"
	"github.com/coreycole/datastarui/components/button"
	"github.com/coreycole/datastarui/components/input"
	"github.com/starfederation/datastar-go/datastar"
)

templ Overlay(w sqlc.World, cp sqlc.Checkpoint, checkpoints []sqlc.Checkpoint) {
	// Expanded state
	<div class="flex flex-col h-screen pointer-events-none [&>*]:pointer-events-auto" data-show="$overlay_expanded">
		@OverlayTopBar(w)
		@CheckpointTree(checkpoints, cp.ID, w.ID)
		<div class="flex-1 flex justify-end pointer-events-none overflow-hidden">
			<div class="flex-1"></div>
			<div class="pointer-events-auto w-80 bg-[rgba(17,17,17,0.92)] backdrop-blur-lg">
				@chat.ChatPanel()
			</div>
		</div>
		@OverlayBottomBar(w)
	</div>
	// Minimized state — starts hidden (overlay_expanded defaults to true)
	<div class="fixed bottom-4 right-4" data-show="!$overlay_expanded" style="display: none;">
		<button class="w-12 h-12 rounded-full bg-primary/90 border-none text-primary-foreground font-bold text-sm cursor-pointer relative"
			data-on:click={ OE.Expand() }>
			CM
			<span class="absolute -top-1 -right-1 bg-destructive text-white text-[10px] rounded-full w-[18px] h-[18px] flex items-center justify-center"
				data-show="$unread_count > 0" data-text="$unread_count" style="display: none;"></span>
		</button>
	</div>
}

templ OverlayTopBar(w sqlc.World) {
	<div class="bg-[rgba(17,17,17,0.92)] backdrop-blur-lg px-4 py-2 flex items-center justify-between border-b border-border">
		<div class="flex items-center gap-3">
			<span class="font-bold text-sm">Creative Mode</span>
			<span class="text-muted-foreground text-[13px]">{ w.Name }</span>
		</div>
		<div class="flex items-center gap-1.5">
			@button.Button(button.ButtonArgs{Size: "sm", Variant: "outline", Attributes: templ.Attributes{"data-on:click": OE.ToggleTree()}}) {
				Tree
			}
			<a href="/"
				class="inline-flex items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 h-8 px-3 text-sm font-medium">
				Lobby
			</a>
			@button.Button(button.ButtonArgs{Size: "sm", Variant: "ghost", Attributes: templ.Attributes{"data-on:click": OE.Minimize()}}) {
				—
			}
		</div>
	</div>
}

templ OverlayBottomBar(w sqlc.World) {
	<div class="bg-[rgba(17,17,17,0.92)] backdrop-blur-lg px-4 py-2 flex flex-col gap-1.5 border-t border-border">
		<div class="flex gap-2 w-full">
			@input.Input(input.InputArgs{
				Placeholder: "Describe what to build...",
				Class:       "flex-1",
				Attributes:  templ.Attributes{"data-bind-prompt_text": true},
			})
			@button.Button(button.ButtonArgs{
				Attributes: templ.Attributes{
					"data-on:click":          datastar.PostSSE(fmt.Sprintf("/world/%s/prompt", w.ID)),
					"data-indicator-fetching": true,
					"data-attr-disabled":     "$fetching",
				},
			}) {
				Build
			}
		</div>
		<div class="text-xs">
			<span data-text="$build_status"
				data-class={ OE.BuildStatusDataClass() }></span>
		</div>
	</div>
}
