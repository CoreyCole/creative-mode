package world

import (
	"creative-mode/harness/internal/db/sqlc"
	"fmt"
)

templ Lineage(ancestry []sqlc.Checkpoint) {
	for _, cp := range ancestry {
		<div class="py-2 border-b border-border/50">
			<div class="text-[13px] flex gap-2 items-baseline">
				<span class="text-muted-foreground font-mono text-xs">[{ TruncateStr(cp.ID, 8) }]</span>
				if cp.Prompt.Valid {
					<span class="text-muted-foreground/80">"{ TruncateStr(cp.Prompt.String, 60) }"</span>
				} else {
					<span class="text-muted-foreground/80">Starter template</span>
				}
				<time class="text-muted-foreground/60 text-[11px] ml-auto">{ TimeAgo(cp.CreatedAt) }</time>
			</div>
			if cp.WorkSummary.Valid {
				<div class="mt-1 pl-4 text-xs text-muted-foreground">
					<span class="text-purple-400 font-semibold">Claude:</span>
					{ cp.WorkSummary.String }
					if cp.FilesChanged.Valid {
						<div class="text-muted-foreground/60 mt-0.5">Files: { cp.FilesChanged.String }</div>
					}
					<div class="text-muted-foreground/60 mt-0.5">
						Build: { cp.Status }
						if cp.BuildDurationMs.Valid {
							({ fmt.Sprintf("%dms", cp.BuildDurationMs.Int64) })
						}
					</div>
				</div>
			}
		</div>
	}
	<div class="text-center text-primary text-xs py-2">you are here</div>
}
