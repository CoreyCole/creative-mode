package selectui

import (
	"fmt"

	"github.com/coreycole/creative-mode/site/internal/ui/utils"
)

// SelectSignals holds the signal state for a select instance.
type SelectSignals struct {
	Open  bool   `json:"open"`
	Value string `json:"value"`
	Label string `json:"label"`
}

templ Select(args SelectArgs) {
	{{
		// Find the initial label from the default value.
		initialLabel := args.Placeholder
		initialValue := ""
		if len(args.Options) > 0 {
			initialValue = args.Options[0].Value
			initialLabel = args.Options[0].Label
		}

		signals := utils.Signals(args.ID, SelectSignals{
			Open:  false,
			Value: initialValue,
			Label: initialLabel,
		})

		toggleOpen := signals.Toggle("open")
		closeDropdown := signals.Set("open", "false")
	}}
	<div
		class={ utils.TwMerge("relative inline-block text-left", args.Class) }
		data-signals={ signals.DataSignals }
		data-on:click__outside={ closeDropdown }
		{ args.Attributes... }
	>
		<!-- Trigger button -->
		<button
			type="button"
			class="inline-flex items-center gap-1.5 rounded-md border border-border bg-card px-3 py-1.5 text-sm font-medium text-foreground hover:bg-accent transition-colors"
			data-on:click={ toggleOpen }
		>
			<span data-text={ signals.Signal("label") }>{ initialLabel }</span>
			<svg class="h-4 w-4 text-muted-foreground" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</button>
		<!-- Dropdown -->
		<div
			class="absolute right-0 z-50 mt-1 min-w-[8rem] rounded-md border border-border bg-popover p-1 shadow-md"
			data-show={ signals.Signal("open") }
		>
			for _, opt := range args.Options {
				{{
					selectExpr := utils.NewExpression().
						Statement(signals.SetString("value", opt.Value)).
						Statement(signals.SetString("label", opt.Label)).
						Statement(closeDropdown)
					if args.OnChange != "" {
						selectExpr = selectExpr.Statement(args.OnChange)
					}
				}}
				<button
					type="button"
					class="flex w-full items-center rounded-sm px-2 py-1.5 text-sm text-foreground hover:bg-accent transition-colors"
					data-on:click={ selectExpr.Build() }
					data-class={ fmt.Sprintf("{'bg-accent/50': %s}", signals.Equals("value", opt.Value)) }
				>
					{ opt.Label }
				</button>
			}
		</div>
	</div>
}
