package chat

import (
	"creative-mode/harness/views/imagegen"
	"creative-mode/harness/views/shared"
)

// ChatPanel renders the tabbed chat UI for the world overlay.
templ ChatPanel() {
	<div class="w-80 flex flex-col border-l border-border bg-[#111]">
		<div class="flex border-b border-border">
			<button class="flex-1 py-2 bg-transparent border-b-2 border-transparent text-muted-foreground cursor-pointer text-[13px] hover:text-foreground/80"
				data-on:click={ CE.SelectTab("global") }
				data-class={ CE.TabActiveClass("global") }>Global</button>
			<button class="flex-1 py-2 bg-transparent border-b-2 border-transparent text-muted-foreground cursor-pointer text-[13px] hover:text-foreground/80"
				data-on:click={ CE.SelectTab("world") }
				data-class={ CE.TabActiveClass("world") }>World</button>
			<button class="flex-1 py-2 bg-transparent border-b-2 border-transparent text-muted-foreground cursor-pointer text-[13px] hover:text-foreground/80"
				data-on:click={ CE.SelectLineageTab() }
				data-class={ CE.TabActiveClass("lineage") }>Lineage</button>
			<button class="flex-1 py-2 bg-transparent border-b-2 border-transparent text-muted-foreground cursor-pointer text-[13px] hover:text-foreground/80"
				data-on:click={ CE.SelectAssetsTab() }
				data-class={ CE.TabActiveClass("assets") }>Assets</button>
		</div>
		<div id="chat-log" class="flex-1 overflow-y-auto px-3 py-2 flex flex-col gap-1" data-show="$active_tab !== 'lineage' && $active_tab !== 'assets'"></div>
		<div id="lineage-view" class="flex-1 overflow-y-auto px-3 py-2 flex flex-col gap-1" data-show="$active_tab === 'lineage'" style="display: none;"></div>
		@imagegen.ImageGenPanel()
		<div class="flex gap-1.5 px-3 py-2 border-t border-border" data-show="$active_tab !== 'lineage' && $active_tab !== 'assets'">
			@ChatInputBar()
		</div>
	</div>
}

// Message is an SSE fragment for an individual chat message (appended to #chat-log).
templ Message(username, avatarURL, content, timestamp string) {
	<div class="text-[13px] leading-snug">
		if avatarURL != "" {
			<img src={ avatarURL } class="w-[18px] h-[18px] rounded-full align-middle inline" alt=""/>
		}
		<span class="font-semibold mr-1.5">{ username }</span>
		<span class="break-words">{ content }</span>
		<time class="text-muted-foreground/60 text-[11px] ml-1">{ timestamp }</time>
	</div>
}

// SystemNotification is an SSE fragment for system notifications.
templ SystemNotification(content string) {
	<div class="text-[13px] leading-snug text-muted-foreground italic">
		<span class="text-muted-foreground/60 text-[11px] mr-1">[sys]</span>
		<span class="break-words">{ content }</span>
	</div>
}

// BuildReadyNotification is an SSE fragment for build completion with a play button.
templ BuildReadyNotification(worldID, cpID, worldName string) {
	<div class="text-[13px] leading-snug text-muted-foreground italic">
		<span class="text-muted-foreground/60 text-[11px] mr-1">[build]</span>
		<span class="break-words">Build ready in { worldName }</span>
		@shared.LoadCheckpointButton(worldID, cpID, "Play")
	</div>
}
