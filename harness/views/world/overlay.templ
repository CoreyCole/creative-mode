package world

import (
	"fmt"
	"creative-mode/harness/internal/db/sqlc"
	"creative-mode/harness/views/chat"
	"github.com/starfederation/datastar-go/datastar"
)

templ Overlay(w sqlc.World, cp sqlc.Checkpoint, checkpoints []sqlc.Checkpoint) {
	// Expanded state
	<div class="overlay-expanded" data-show="$overlay_expanded">
		@OverlayTopBar(w)
		@CheckpointTree(checkpoints, cp.ID, w.ID)
		<div class="overlay-middle">
			<div class="game-area"></div>
			@chat.ChatPanel()
		</div>
		@OverlayBottomBar(w)
	</div>
	// Minimized state — starts hidden (overlay_expanded defaults to true)
	<div class="overlay-minimized" data-show="!$overlay_expanded" style="display: none;">
		<button data-on-click={ OE.Expand() }>
			CM
			<span class="badge" data-show="$unread_count > 0" data-text="$unread_count" style="display: none;"></span>
		</button>
	</div>
}

templ OverlayTopBar(w sqlc.World) {
	<div class="overlay-bar overlay-top-bar">
		<div class="top-bar-left">
			<span class="brand">Creative Mode</span>
			<span class="world-name">{ w.Name }</span>
		</div>
		<div class="top-bar-right">
			<button class="btn btn-sm" data-on-click={ OE.ToggleTree() }>Tree</button>
			<a href="/" class="btn btn-sm btn-muted">Lobby</a>
			<button class="btn btn-sm btn-muted" data-on-click={ OE.Minimize() }>—</button>
		</div>
	</div>
}

templ OverlayBottomBar(w sqlc.World) {
	<div class="overlay-bar overlay-bottom-bar">
		<div class="prompt-bar">
			<input placeholder="Describe what to build..."
				data-bind-prompt_text
				class="prompt-input"/>
			<button class="btn btn-primary"
				data-on-click={ datastar.PostSSE(fmt.Sprintf("/world/%s/prompt", w.ID)) }
				data-indicator-fetching
				data-attr-disabled="$fetching">
				Build
			</button>
		</div>
		<div class="status-bar">
			<span class="build-status"
				data-text="$build_status"
				data-class={ OE.BuildStatusDataClass() }></span>
		</div>
	</div>
}
